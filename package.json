{
  "name": "liquor-control",
  "version": "0.1.0",
  "private": true,
  "description": "LiquorControl — inventario, clientes QR y control de consumo (SaaS multi-tenant)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run start:dev -w @liquor-control/backend",
    "dev:frontend": "npm run dev -w @liquor-control/frontend",
    "build": "npm run build -w @liquor-control/shared-types && npm run build -w @liquor-control/backend && npm run build -w @liquor-control/frontend",
    "prisma:generate": "prisma generate --schema=database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=database/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=database/prisma/schema.prisma",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
