generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
  CUSTOMER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CardStatus {
  ACTIVE
  REVOKED
  LOST
  EXPIRED
}

enum UnitKind {
  COUNT
  VOLUME
  WEIGHT
  OTHER
}

enum ProductModality {
  UNIT
  CASE
  BULK
}

enum InventoryMovementType {
  PURCHASE_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  ALLOCATION_OUT
  ALLOCATION_REVERSAL
  SALE_OUT
  SALE_REVERSAL
  TRANSFER_IN
  TRANSFER_OUT
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  RECEIVED
  CANCELLED
}

enum AllocationStatus {
  COMPLETED
  REVERSED
}

enum SaleTrigger {
  ALLOCATION
  CONSUMPTION
  MANUAL
}

enum SaleStatus {
  PENDING
  PAID
  PARTIAL
  CANCELLED
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum ReturnType {
  ALLOCATION
  SALE
}

enum ReturnStatus {
  COMPLETED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

// ─── Tenant & Auth ────────────────────────────────────────────────────────────

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  users                       User[]
  customers                   Customer[]
  cards                       Card[]
  unitsOfMeasure              UnitOfMeasure[]
  categories                  Category[]
  products                    Product[]
  productPresentations        ProductPresentation[]
  warehouses                  Warehouse[]
  branches                    Branch[]
  inventoryBalances           InventoryBalance[]
  inventoryMovements          InventoryMovement[]
  orders                      Order[]
  allocations                 Allocation[]
  customerAllocationBalances  CustomerAllocationBalance[]
  consumptions                Consumption[]
  sales                       Sale[]
  suppliers                   Supplier[]
  cashSessions                CashSession[]
  returns                     StockReturn[]
  customerPrices              CustomerPrice[]
  auditLogs                   AuditLog[]
  rolePermissions             RolePermission[]
  userPermissions             UserPermission[]
  stockTransfers              StockTransfer[]

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  email        String
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  customerId   String?    @map("customer_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  customer     Customer?  @relation(fields: [customerId], references: [id])
  allocations  Allocation[]  @relation("AllocationCreatedBy")
  consumptions Consumption[] @relation("ConsumptionCreatedBy")
  cashSessionsOpened CashSession[] @relation("CashSessionOpenedBy")
  cashSessionsClosed CashSession[] @relation("CashSessionClosedBy")
  returns            StockReturn[] @relation("ReturnCreatedBy")
  payments           Payment[]     @relation("PaymentRecordedBy")
  auditLogs          AuditLog[]    @relation("AuditLogActor")
  userPermissions    UserPermission[]
  defaultBranchId    String?       @map("default_branch_id") @db.Uuid
  defaultBranch      Branch?       @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id])
  stockTransfers     StockTransfer[] @relation("TransferCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("users")
}

// ─── Customers & Cards ────────────────────────────────────────────────────────

model Customer {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  code         String
  name         String
  /// JSON array of billing modes, e.g. ["CHARGE_ON_ALLOCATION","CHARGE_ON_CONSUMPTION"]
  billingModes Json           @default("[\"CHARGE_ON_ALLOCATION\"]") @map("billing_modes")
  email        String?
  phone        String?
  status       CustomerStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  tenant              Tenant                       @relation(fields: [tenantId], references: [id])
  cards               Card[]
  users               User[]
  allocations         Allocation[]
  allocationBalances  CustomerAllocationBalance[]
  consumptions        Consumption[]
  sales               Sale[]
  returns             StockReturn[]
  prices              CustomerPrice[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("customers")
}

model Card {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  customerId String     @map("customer_id") @db.Uuid
  /// SHA-256 (hex) del token opaco; el token en claro NUNCA se persiste
  tokenHash  String     @unique @map("token_hash")
  label      String?
  status     CardStatus @default(ACTIVE)
  issuedAt   DateTime   @default(now()) @map("issued_at")
  revokedAt  DateTime?  @map("revoked_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("cards")
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

model UnitOfMeasure {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  kind      UnitKind @default(COUNT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  productsAsBase Product[]             @relation("ProductBaseUnit")
  presentations  ProductPresentation[]

  @@unique([tenantId, code])
  @@map("units_of_measure")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("categories")
}

model Product {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  baseUnitId       String          @map("base_unit_id") @db.Uuid
  categoryId       String?         @map("category_id") @db.Uuid
  sku              String
  name             String
  modality         ProductModality @default(UNIT)
  active           Boolean         @default(true)
  /// Precio de venta por unidad base (MXN). Listas por cliente pueden sobreescribir.
  defaultUnitPrice Decimal         @default(0) @map("default_unit_price") @db.Decimal(18, 2)
  /// Alerta de stock bajo cuando el balance general ≤ este mínimo (unidad base).
  minStock         Decimal         @default(0) @map("min_stock") @db.Decimal(18, 6)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  tenant             Tenant                       @relation(fields: [tenantId], references: [id])
  baseUnit           UnitOfMeasure                @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])
  category           Category?                    @relation(fields: [categoryId], references: [id])
  presentations      ProductPresentation[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  orderLines         OrderLine[]
  allocationLines    AllocationLine[]
  allocationBalances CustomerAllocationBalance[]
  consumptionLines   ConsumptionLine[]
  saleLines          SaleLine[]
  returnLines        StockReturnLine[]
  customerPrices     CustomerPrice[]
  transferLines      StockTransferLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, active])
  @@index([tenantId, categoryId])
  @@map("products")
}

model CustomerPrice {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  unitPrice  Decimal  @map("unit_price") @db.Decimal(18, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([tenantId, customerId, productId])
  @@map("customer_prices")
}

model ProductPresentation {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  unitId       String   @map("unit_id") @db.Uuid
  name         String
  factorToBase Decimal  @map("factor_to_base") @db.Decimal(18, 6)
  isDefault    Boolean  @default(false) @map("is_default")
  barcode      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  product         Product          @relation(fields: [productId], references: [id])
  unit            UnitOfMeasure    @relation(fields: [unitId], references: [id])
  allocationLines AllocationLine[]

  @@unique([tenantId, productId, name])
  @@index([tenantId, productId])
  @@map("product_presentations")
}

// ─── Warehouses & Inventory ───────────────────────────────────────────────────

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  warehouses Warehouse[]
  users      User[]      @relation("UserDefaultBranch")

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("branches")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant             Tenant                       @relation(fields: [tenantId], references: [id])
  branch             Branch?                      @relation(fields: [branchId], references: [id])
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  orders             Order[]
  allocations        Allocation[]
  allocationBalances CustomerAllocationBalance[]
  consumptions       Consumption[]
  cashSessions       CashSession[]
  returns            StockReturn[]
  sales              Sale[]
  transfersFrom      StockTransfer[]              @relation("TransferFromWarehouse")
  transfersTo        StockTransfer[]              @relation("TransferToWarehouse")

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
  @@map("warehouses")
}

model StockTransfer {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  fromWarehouseId   String         @map("from_warehouse_id") @db.Uuid
  toWarehouseId     String         @map("to_warehouse_id") @db.Uuid
  createdByUserId   String         @map("created_by_user_id") @db.Uuid
  number            String
  status            TransferStatus @default(DRAFT)
  notes             String?
  completedAt       DateTime?      @map("completed_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  fromWarehouse   Warehouse           @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse           @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])
  createdByUser   User                @relation("TransferCreatedBy", fields: [createdByUserId], references: [id])
  lines           StockTransferLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@map("stock_transfers")
}

model StockTransferLine {
  id           String  @id @default(uuid()) @db.Uuid
  transferId   String  @map("transfer_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  quantityBase Decimal @map("quantity_base") @db.Decimal(18, 6)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@map("stock_transfer_lines")
}

model InventoryBalance {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  warehouseId   String   @map("warehouse_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  quantityBase  Decimal  @default(0) @map("quantity_base") @db.Decimal(18, 6)
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([tenantId, warehouseId, productId])
  @@map("inventory_balances")
}

model InventoryMovement {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  warehouseId        String                @map("warehouse_id") @db.Uuid
  productId          String                @map("product_id") @db.Uuid
  type               InventoryMovementType
  /// Signed quantity in base units (positive = in, negative = out) OR always positive with type direction — we use signed
  quantityBase       Decimal               @map("quantity_base") @db.Decimal(18, 6)
  reversesMovementId String?               @map("reverses_movement_id") @db.Uuid
  referenceId        String?               @map("reference_id") @db.Uuid
  referenceType      String?               @map("reference_type")
  notes              String?
  createdAt          DateTime              @default(now()) @map("created_at")
  createdByUserId    String?               @map("created_by_user_id") @db.Uuid

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  warehouse        Warehouse          @relation(fields: [warehouseId], references: [id])
  product          Product            @relation(fields: [productId], references: [id])
  reversesMovement InventoryMovement? @relation("MovementReversal", fields: [reversesMovementId], references: [id])
  reversedBy       InventoryMovement[] @relation("MovementReversal")

  @@index([tenantId, warehouseId, productId, createdAt])
  @@index([tenantId, referenceType, referenceId])
  @@map("inventory_movements")
}

// ─── Suppliers & Purchase Orders ──────────────────────────────────────────────

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  email     String?
  phone     String?
  taxId     String?  @map("tax_id")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  orders Order[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("suppliers")
}

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  warehouseId  String      @map("warehouse_id") @db.Uuid
  supplierId   String?     @map("supplier_id") @db.Uuid
  number       String
  status       OrderStatus @default(DRAFT)
  notes        String?
  totalAmount  Decimal     @default(0) @map("total_amount") @db.Decimal(18, 2)
  receivedAt   DateTime?   @map("received_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  warehouse Warehouse   @relation(fields: [warehouseId], references: [id])
  supplier  Supplier?   @relation(fields: [supplierId], references: [id])
  lines     OrderLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("orders")
}

model OrderLine {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  quantityBase Decimal @map("quantity_base") @db.Decimal(18, 6)
  unitCost     Decimal @default(0) @map("unit_cost") @db.Decimal(18, 2)
  lineTotal    Decimal @default(0) @map("line_total") @db.Decimal(18, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_lines")
}

// ─── Cash register (caja) ─────────────────────────────────────────────────────

model CashSession {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  warehouseId     String           @map("warehouse_id") @db.Uuid
  openedByUserId  String           @map("opened_by_user_id") @db.Uuid
  closedByUserId  String?          @map("closed_by_user_id") @db.Uuid
  status          CashSessionStatus @default(OPEN)
  openingFloat    Decimal          @default(0) @map("opening_float") @db.Decimal(18, 2)
  closingAmount   Decimal?         @map("closing_amount") @db.Decimal(18, 2)
  expectedCash    Decimal?         @map("expected_cash") @db.Decimal(18, 2)
  notes           String?
  openedAt        DateTime         @default(now()) @map("opened_at")
  closedAt        DateTime?        @map("closed_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  openedByUser User     @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id])
  closedByUser User?    @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id])
  sales        Sale[]
  payments     Payment[]

  @@index([tenantId, status, openedAt])
  @@map("cash_sessions")
}

// ─── Allocations ──────────────────────────────────────────────────────────────

model Allocation {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  customerId      String           @map("customer_id") @db.Uuid
  warehouseId     String           @map("warehouse_id") @db.Uuid
  createdByUserId String           @map("created_by_user_id") @db.Uuid
  status          AllocationStatus @default(COMPLETED)
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  customer      Customer         @relation(fields: [customerId], references: [id])
  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id])
  createdByUser User             @relation("AllocationCreatedBy", fields: [createdByUserId], references: [id])
  lines         AllocationLine[]

  @@index([tenantId, customerId, createdAt])
  @@map("allocations")
}

model AllocationLine {
  id             String   @id @default(uuid()) @db.Uuid
  allocationId   String   @map("allocation_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  presentationId String?  @map("presentation_id") @db.Uuid
  quantityBase   Decimal  @map("quantity_base") @db.Decimal(18, 6)

  allocation   Allocation           @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id])
  presentation ProductPresentation? @relation(fields: [presentationId], references: [id])

  @@index([allocationId])
  @@map("allocation_lines")
}

model CustomerAllocationBalance {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  customerId        String   @map("customer_id") @db.Uuid
  warehouseId       String   @map("warehouse_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  /// Remaining = assigned - consumed - returned (unidad base)
  quantityBase      Decimal  @default(0) @map("quantity_base") @db.Decimal(18, 6)
  quantityAssigned  Decimal  @default(0) @map("quantity_assigned") @db.Decimal(18, 6)
  quantityConsumed  Decimal  @default(0) @map("quantity_consumed") @db.Decimal(18, 6)
  quantityReturned  Decimal  @default(0) @map("quantity_returned") @db.Decimal(18, 6)
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  customer  Customer  @relation(fields: [customerId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([tenantId, customerId, warehouseId, productId])
  @@map("customer_allocation_balances")
}

// ─── Consumptions ─────────────────────────────────────────────────────────────

model Consumption {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  warehouseId     String   @map("warehouse_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  /// Unique per tenant — retries with same key return the same record
  idempotencyKey  String   @map("idempotency_key")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  customer      Customer          @relation(fields: [customerId], references: [id])
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  createdByUser User              @relation("ConsumptionCreatedBy", fields: [createdByUserId], references: [id])
  lines         ConsumptionLine[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, customerId, createdAt])
  @@map("consumptions")
}

model ConsumptionLine {
  id            String  @id @default(uuid()) @db.Uuid
  consumptionId String  @map("consumption_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  quantityBase  Decimal @map("quantity_base") @db.Decimal(18, 6)

  consumption Consumption @relation(fields: [consumptionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([consumptionId])
  @@map("consumption_lines")
}

// ─── Sales, payments & AR ─────────────────────────────────────────────────────

model Sale {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  customerId    String?     @map("customer_id") @db.Uuid
  warehouseId   String?     @map("warehouse_id") @db.Uuid
  cashSessionId String?     @map("cash_session_id") @db.Uuid
  number        String?
  trigger       SaleTrigger
  status        SaleStatus  @default(PENDING)
  totalAmount   Decimal     @default(0) @map("total_amount") @db.Decimal(18, 2)
  amountPaid    Decimal     @default(0) @map("amount_paid") @db.Decimal(18, 2)
  currency      String      @default("MXN")
  referenceId   String?     @map("reference_id") @db.Uuid
  referenceType String?     @map("reference_type")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id])
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])
  lines       SaleLine[]
  payments    Payment[]
  returns     StockReturn[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, referenceType, referenceId])
  @@unique([tenantId, number])
  @@map("sales")
}

model SaleLine {
  id           String  @id @default(uuid()) @db.Uuid
  saleId       String  @map("sale_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  quantityBase Decimal @map("quantity_base") @db.Decimal(18, 6)
  unitPrice    Decimal @map("unit_price") @db.Decimal(18, 2)
  lineTotal    Decimal @map("line_total") @db.Decimal(18, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@map("sale_lines")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  saleId          String        @map("sale_id") @db.Uuid
  cashSessionId   String?       @map("cash_session_id") @db.Uuid
  recordedByUserId String?      @map("recorded_by_user_id") @db.Uuid
  method          PaymentMethod @default(CASH)
  amount          Decimal       @db.Decimal(18, 2)
  status          PaymentStatus @default(COMPLETED)
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")

  sale          Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])
  recordedByUser User?       @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id])

  @@index([saleId])
  @@index([cashSessionId])
  @@map("payments")
}

// ─── Returns (devoluciones) ───────────────────────────────────────────────────

model StockReturn {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  warehouseId     String       @map("warehouse_id") @db.Uuid
  customerId      String?      @map("customer_id") @db.Uuid
  saleId          String?      @map("sale_id") @db.Uuid
  allocationId    String?      @map("allocation_id") @db.Uuid
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  type            ReturnType
  status          ReturnStatus @default(COMPLETED)
  number          String
  reason          String?
  totalCredit     Decimal      @default(0) @map("total_credit") @db.Decimal(18, 2)
  createdAt       DateTime     @default(now()) @map("created_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  customer      Customer?         @relation(fields: [customerId], references: [id])
  sale          Sale?             @relation(fields: [saleId], references: [id])
  createdByUser User              @relation("ReturnCreatedBy", fields: [createdByUserId], references: [id])
  lines         StockReturnLine[]

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@map("returns")
}

model StockReturnLine {
  id           String  @id @default(uuid()) @db.Uuid
  returnId     String  @map("return_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  quantityBase Decimal @map("quantity_base") @db.Decimal(18, 6)
  unitPrice    Decimal @default(0) @map("unit_price") @db.Decimal(18, 2)
  lineCredit   Decimal @default(0) @map("line_credit") @db.Decimal(18, 2)

  stockReturn StockReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@map("return_lines")
}

// ─── Audit & permissions (Fase 3) ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  context    String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation("AuditLogActor", fields: [actorUserId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorUserId, createdAt])
  @@map("audit_logs")
}

/// Catálogo global de permisos (código estable).
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

/// Permisos por rol dentro de un tenant (customizables).
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  role         UserRole
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([tenantId, role, permissionId])
  @@index([tenantId, role])
  @@map("role_permissions")
}

/// Override por usuario (grant o deny).
model UserPermission {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([tenantId, userId, permissionId])
  @@index([tenantId, userId])
  @@map("user_permissions")
}
